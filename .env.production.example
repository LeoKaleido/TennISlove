# Copiare in .env sul VPS e compilare. Permessi: chmod 600 .env
# indirizzo pubblico dell'app, citato nelle email (es. https://tennislove.it). L'HTTPS lo fa il server (D-056)
APP_URL=

# dove ascolta il container: solo dal server, il suo web server inoltra qui (predefinito)
# HTTP_BIND=127.0.0.1:8080

POSTGRES_USER=tentennis
# lunga e casuale, solo lettere e numeri perché finisce in un URL: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=tentennis

# Casella email su Plesk (D-055): dati in Plesk → Posta → la casella → impostazioni del client di posta
SMTP_HOST=mail.DOMINIO
# 465 = SSL; con 587 la connessione passa a TLS da sola
SMTP_PORT=465
SMTP_USER=noreply@DOMINIO
SMTP_PASS=
# il mittente deve essere la stessa casella di SMTP_USER
MAIL_FROM="TennIsLove <noreply@DOMINIO>"

SESSION_DAYS=90
LOGIN_CODE_MINUTES=15
