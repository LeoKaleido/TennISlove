# Copiare in .env sul VPS e compilare. Permessi: chmod 600 .env
# dominio da scegliere (D-050): es. DOMAIN=esempio.it e APP_URL=https://esempio.it
DOMAIN=
APP_URL=

POSTGRES_USER=tentennis
# lunga e casuale, solo lettere e numeri perché finisce in un URL: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=tentennis

# Resend via SMTP (D-030): verificare host e utente nella dashboard di Resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="TennISlove <noreply@mail.DOMINIO>"

SESSION_DAYS=90
LOGIN_CODE_MINUTES=15
